 ;; The durability plane (kosatsu.methods.anchor, 2026-08-22). Delegates to
 ;; kotoba-lang/kotobase-anchor-fevm; this repo grows no second anchor format.
 ;; It produces PLANS only -- G8 still governs whether an adapter may run.
 :actor/anchor
 {:anchor/owner "kotoba-lang/kotobase-anchor-fevm"
  :anchor/providers {:transparency "chainless signed append-only log; no chain, gas or RPC"
                     :evm "public-chain notarisation; opt-in and irreversible"}
  :anchor/payload "{database-id, epoch, logical-checkpoint-root} -- the root is an opaque CID"
  :anchor/discloses "nothing: no subject label, authority id or datom crosses the boundary (G5)"
  :anchor/makes-falsifiable "G4 -- if the record moves under a previously anchored head, the commitment no longer opens"
  :anchor/refusals
  [{:gate "G10-anchor"
    :rule "an :evm plan is refused unless the log is wholly :authoritative -- a public-chain artefact is permanent and cannot say 'this was synthetic'"}
   {:gate "anchor-provider"
    :rule "provider is required with no default; a defaulted destination is a destination nobody chose"}
   {:gate "anchor-evidence-floor"
    :rule "an empty log is {:ok? false :checked 0 :reason :empty-log}; checked-zero never reads as verified-intact"}
   {:gate "anchor-unverified"
    :rule "checkpoint throws on an unverified chain rather than returning nil"}]
  :anchor/database-id "kosatsu/<representative|authoritative|mixed|unsourced> -- the sourcing mode (G10) is INSIDE the commitment"
  :anchor/deployed? false}

 :actor/id "kosatsu"}
